#exemplo de .env para a aplicação
SECRET_KEY=
DATABASE_URL=postgresql://usuario:senha@localhost:porta-definida-no-postgres/nome_do_banco
BREVO_API_KEY=chave-api-brevo

#DEBUG=True apenas em desenvolvimento local em produção colocar false.
DEBUG=True
# Hosts liberados a servir a aplicação, separados por vírgula (obrigatório quando DEBUG=False).
ALLOWED_HOSTS=localhost,127.0.0.1

# SMTP da Brevo usado no envio de e-mails (esqueci minha senha, avisos de vencimento).
BREVO_SMTP_USER=usuario-smtp-brevo
BREVO_SMTP_PASSWORD=senha-smtp-brevo
# Só o endereço, sem nome: precisa ser um remetente verificado no painel do Brevo.
DEFAULT_FROM_EMAIL=no-reply@seudominio.com

# Quantos proxies confiáveis ficam na frente da aplicação (ex.: 1 atrás do proxy da hospedagem).
# Com 0 (padrão), o cabeçalho X-Forwarded-For é ignorado e vale o IP da conexão.
PROXIES_CONFIAVEIS=0

# --- Produção (Render) ---
# Liga redirecionamento para HTTPS e cookies seguros. Deixe False no desenvolvimento.
HTTPS=False
# Domínios extras aceitos em formulários (o domínio do Render entra sozinho).
CSRF_TRUSTED_ORIGINS=
# Imagens dos cursos no Cloudinary (cloudinary://API_KEY:API_SECRET@CLOUD_NAME). Vazio = pasta media/.
CLOUDINARY_URL=
