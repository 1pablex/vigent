#exemplo de .env para a aplicação
SECRET_KEY=
DATABASE_URL=postgresql://usuario:senha@localhost:porta-definida-no-postgres/nome_do_banco
BREVO_API_KEY=chave-api-brevo

#DEBUG=True apenas em desenvolvimento local em produção colocar false.
DEBUG=True
# Hosts liberados a servir a aplicação, separados por vírgula (obrigatório quando DEBUG=False).
ALLOWED_HOSTS=localhost,127.0.0.1

# SMTP da Brevo usado no envio de e-mails (esqueci minha senha, avisos de vencimento).
BREVO_SMTP_USER=usuario-smtp-brevo
BREVO_SMTP_PASSWORD=senha-smtp-brevo
DEFAULT_FROM_EMAIL=Vigent <no-reply@seudominio.com>
